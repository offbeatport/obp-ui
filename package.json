{
    "name": "@paperkit/ui",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Paperkit - the editorial \"paper\" design system: tokens, primitives and presentational components shared by the web app and the desktop (Tauri) app.",
    "sideEffects": ["**/*.css"],
    "files": ["src", "README.md"],
    "style": "./src/styles/index.css",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./types": {
            "types": "./src/types/index.ts",
            "default": "./src/types/index.ts"
        },
        "./canvas": {
            "types": "./src/canvas/index.ts",
            "default": "./src/canvas/index.ts"
        },
        "./styles.css": "./src/styles/index.css",
        "./tokens.css": "./src/styles/tokens.css",
        "./base.css": "./src/styles/base.css",
        "./keyframes.css": "./src/styles/keyframes.css",
        "./shell.css": "./src/styles/shell.css",
        "./canvas.css": "./src/styles/canvas.css",
        "./fonts.css": "./src/styles/fonts.css",
        "./desktop.css": "./src/styles/desktop.css",
        "./package.json": "./package.json"
    },
    "scripts": {
        "typecheck": "tsc --noEmit && tsc --noEmit -p gallery/tsconfig.json",
        "ui": "vite gallery"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@fontsource-variable/space-grotesk": "^5.3.0",
        "@fontsource/spectral": "^5.3.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^0.474.0",
        "radix-ui": "^1.6.2",
        "tailwind-merge": "^3.3.1",
        "tw-animate-css": "^1.4.0"
    },
    "peerDependencies": {
        "@xyflow/react": "^12",
        "react": "^19",
        "react-dom": "^19",
        "tailwindcss": "^4.2"
    },
    "peerDependenciesMeta": {
        "@xyflow/react": {
            "optional": true
        }
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.2.2",
        "@types/react": "^19.0.7",
        "@types/react-dom": "^19.0.3",
        "@vitejs/plugin-react": "^4.3.4",
        "@xyflow/react": "^12.11.2",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "tailwindcss": "^4.2.2",
        "typescript": "^5.7.3",
        "vite": "^7.3.2"
    }
}
