{
    "name": "obp-ui",
    "version": "0.1.0",
    "type": "module",
    "description": "The Offbeatport design system: tokens, primitives and presentational components shared across every app.",
    "sideEffects": ["**/*.css"],
    "files": ["src", "README.md", "DESIGN.md"],
    "style": "./src/styles/index.css",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./canvas": {
            "types": "./src/canvas/index.ts",
            "default": "./src/canvas/index.ts"
        },
        "./chat": {
            "types": "./src/chat/index.ts",
            "default": "./src/chat/index.ts"
        },
        "./console": {
            "types": "./src/console/index.ts",
            "default": "./src/console/index.ts"
        },
        "./nav-ui": {
            "types": "./src/nav-ui/index.ts",
            "default": "./src/nav-ui/index.ts"
        },
        "./shell": {
            "types": "./src/shell/index.ts",
            "default": "./src/shell/index.ts"
        },
        "./styles.css": "./src/styles/index.css",
        "./tokens.css": "./src/styles/tokens.css",
        "./base.css": "./src/styles/base.css",
        "./keyframes.css": "./src/styles/keyframes.css",
        "./shell.css": "./src/styles/shell.css",
        "./canvas.css": "./src/styles/canvas.css",
        "./fonts.css": "./src/styles/fonts.css",
        "./fonts-alt.css": "./src/styles/fonts-alt.css",
        "./desktop.css": "./src/styles/desktop.css",
        "./package.json": "./package.json"
    },
    "scripts": {
        "dev": "vite gallery",
        "ui": "vite gallery",
        "build:gallery": "vite build gallery",
        "typecheck": "tsc --noEmit && tsc --noEmit -p gallery/tsconfig.json",
        "lint": "biome check .",
        "lint:fix": "biome check --write ."
    },
    "dependencies": {
        "@base-ui/react": "^1.7.0",
        "@fontsource-variable/fraunces": "^5.3.0",
        "@fontsource-variable/geist": "^5.3.0",
        "@fontsource-variable/geist-mono": "^5.3.0",
        "@fontsource-variable/ibm-plex-sans": "^5.3.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@fontsource-variable/space-grotesk": "^5.3.0",
        "@fontsource/instrument-serif": "^5.3.0",
        "@fontsource/spectral": "^5.3.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.35.0",
        "tailwind-merge": "^3.3.1"
    },
    "peerDependencies": {
        "@xyflow/react": "^12",
        "react": "^19",
        "react-dom": "^19",
        "tailwindcss": "^4.2"
    },
    "peerDependenciesMeta": {
        "@xyflow/react": {
            "optional": true
        }
    },
    "devDependencies": {
        "@biomejs/biome": "^1.9.4",
        "@tailwindcss/vite": "^4.2.2",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@vitejs/plugin-react": "^4.3.4",
        "@xyflow/react": "^12.11.2",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "tailwindcss": "^4.2.2",
        "typescript": "^5.7.3",
        "vite": "^7.3.2"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/offbeatport/obp-ui.git"
    },
    "packageManager": "pnpm@10.30.3+sha256.ff0a72140f6a6d66c0b284f6c9560aff605518e28c29aeac25fb262b74331588"
}
