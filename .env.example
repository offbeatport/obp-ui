# Local SQLite file (optional; defaults to ./cslopslop.db)
# DATABASE_URL=./cslopslop.db

# ── Build harness (the coding-agent "hands" that build companies) ─────────────
# Which harness the run executor uses. Default (unset) = NoopHarness (no AI, control
# plane only). Set to `claude` to build for real with the local `claude` CLI.
# CSLOP_HARNESS=claude
# Path/name of the harness binary (default: claude).
# CSLOP_HARNESS_BIN=claude

# ── Credentials (BYOK) ────────────────────────────────────────────────────────
# Harness auth is auto-detected: if ANTHROPIC_API_KEY or OPENROUTER_API_KEY is set →
# "apikey" mode (real $ metering); otherwise "subscription" mode (uses the host's
# `claude` login, budget cap is informational).
#
# Anthropic API (metered claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# OpenRouter — default AI proxy for the *thinking* tasks (scoring/planning/drafting)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-4.8
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Claude CLI (subscription mode) — no key needed, uses your local `claude` login.
# CLAUDE_CLI_MODEL=

# ── Payments (test-mode only in v1) ───────────────────────────────────────────
# Stripe test-mode secret key (sk_test_...). Real go-live stays behind the payments seam.
STRIPE_TEST_SECRET_KEY=
