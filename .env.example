# Local SQLite file (optional; defaults to ./cslopslop.db)
# DATABASE_URL=./cslopslop.db

# --- Agent providers (also configurable in-app via Settings → Agent) ---
# Settings saved in the app DB take precedence over these env vars.

# Default provider on first run: claude-cli | anthropic | openrouter
AI_PROVIDER=claude-cli

# Anthropic API (provider = anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# OpenRouter (provider = openrouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-4.8

# Claude CLI (provider = claude-cli) — no key needed, uses your local `claude` login.
# Optional model override passed to `claude --model`.
CLAUDE_CLI_MODEL=
