# App-specific secrets. Per-app values that must NOT be shared with sibling apps:
# - auth secrets (shared = cross-app session bleed = security incident)
# - database URL (shared = all apps writing to one file)
# - Sentry DSN (shared = errors land in wrong project)
# - PostHog key (shared = funnels become noise)
# - Polar product/webhook secrets (per-app product, per-app signed payloads)
#
# Provider keys (Resend, OpenRouter, Polar org token) live in the monorepo
# root's .env.shared and are auto-loaded by vite.config.ts.

# === Database (per-app SQLite file) ===
DATABASE_URL=./app.db

# === Auth (better-auth) ===
# UNIQUE per app - generated by the build-microsaas skill.
BETTER_AUTH_SECRET=__BETTER_AUTH_SECRET__
BETTER_AUTH_URL=http://localhost:3000

# OAuth - Google provider (optional, per-app callback URL)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === Sentry (one project per app for error attribution) ===
VITE_SENTRY_DSN=

# === PostHog (one project per app for clean funnel data) ===
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# === Polar - app-specific product / webhook ===
POLAR_PRODUCT_IDS=
POLAR_WEBHOOK_SECRET=

# === Niche-specific (added per archetype) ===
# CRON_SECRET=
# (anthropic / openai keys live in .env.shared as OPENROUTER_API_KEY)
