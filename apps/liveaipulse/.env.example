# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3002

# DB
DATABASE_URL=./app.db

# Admin (comma-separated emails)
ADMIN_USERS=you@example.com

# OpenRouter
OPENROUTER_API_KEY=
