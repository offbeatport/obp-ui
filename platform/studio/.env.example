# ── AI Processing ─────────────────────────────────────────────────────────────
# Required: used for clustering signals and generating briefs
OPENROUTER_API_KEY=sk-or-...

# Models via OpenRouter - see openrouter.ai/models for IDs
# Main model: clustering, briefs, analysis
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5

# Keyword generation: runs once on project create - needs good instruction-following
OPENROUTER_KEYWORD_MODEL=anthropic/claude-haiku-4-5

# Prescoring: lightweight per-signal pass - cheap is fine
OPENROUTER_PRESCORE_MODEL=google/gemini-3.1-flash-lite-preview

# Embeddings: semantic deduplication
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small

# ── Scraper settings ──────────────────────────────────────────────────────────

# How many days back to fetch signals (default: 30)
# Can also be changed from the Channels UI - this is the fallback default
LOOKBACK_DAYS=30

# ── Scrapers (all optional - each skips gracefully if key not set) ────────────

# GitHub → github.com/settings/tokens → Personal access tokens (classic)
# Scopes needed: public_repo (for Issues + Discussions search)
# Without this token GitHub scraping is skipped entirely
GITHUB_TOKEN=

# X/Twitter via Grok live search → console.x.ai
XAI_API_KEY=

# Bluesky → bsky.app Settings → Privacy → App Passwords
BSKY_IDENTIFIER=
BSKY_APP_PASSWORD=

# Product Hunt → producthunt.com/v2/oauth/applications → create app → Developer Token
PRODUCTHUNT_TOKEN=

# Podcast Index → api.podcastindex.org → Create Account → API Key + Secret
PODCAST_INDEX_KEY=
PODCAST_INDEX_SECRET=

# YouTube → console.cloud.google.com → Enable "YouTube Data API v3" → Credentials → API Key
YOUTUBE_API_KEY=

# Adzuna (Job Boards) → developer.adzuna.com → Register → App ID + Key
# Aggregates Indeed, LinkedIn, Glassdoor, Greenhouse, Lever and 100+ job boards
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# DataForSEO (SEO discovery tab + Trustpilot reviews) → dataforseo.com → Dashboard → API credentials
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ── Database (optional - defaults to ./burningdemand.db) ─────────────────────
# DATABASE_URL=./burningdemand.db
