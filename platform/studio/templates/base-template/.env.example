# Database
DATABASE_URL=./app.db

# Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# OAuth - GitHub provider (optional but scaffolded)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Sentry error tracking - VITE_ prefix exposes to browser bundle
VITE_SENTRY_DSN=

# PostHog analytics - VITE_ prefix exposes to browser bundle
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# Polar.sh payments
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ORGANIZATION_ID=
# Comma-separated product IDs matching your Polar products
POLAR_PRODUCT_IDS=
